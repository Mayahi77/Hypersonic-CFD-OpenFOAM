FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1736.37 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (1736.37 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    farfield
    {
        type            fixedValue;
        value           uniform (1736.37 0 0);
    }

    cylinderWalls
    {
        type            noSlip;
    }

    wedgeFront
    {
        type            wedge;
    }

    wedgeBack
    {
        type            wedge;
    }
}

